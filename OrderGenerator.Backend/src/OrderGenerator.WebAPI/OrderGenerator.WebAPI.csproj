<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\OrderGenerator.Domain\OrderGenerator.Domain.csproj" />
    <ProjectReference Include="..\OrderGenerator.Application\OrderGenerator.Application.csproj" />
    <ProjectReference Include="..\OrderGenerator.Infrastructure\OrderGenerator.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy FIX configuration files to output directory during build -->
  <ItemGroup>
    <Content Include="../../fix.cfg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Create store and log directories -->
  <Target Name="CreateDirectories" BeforeTargets="Build">
    <MakeDir Directories="$(OutDir)store;$(OutDir)log" />
  </Target>

</Project>
