<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderAccumulator.Core\OrderAccumulator.Core.csproj" />
    <ProjectReference Include="..\OrderAccumulator.Infrastructure\OrderAccumulator.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy FIX configuration files to output directory during build -->
  <ItemGroup>
    <Content Include="../../fix.cfg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Create store and log directories -->
  <Target Name="CreateDirectories" BeforeTargets="Build">
    <MakeDir Directories="$(OutDir)store;$(OutDir)log" />
  </Target>

</Project>
